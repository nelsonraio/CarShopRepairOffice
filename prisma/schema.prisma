  nome          String     @unique(map: "nome_perfil") @db.VarChar(50)
  descricao     String?    @db.Text
  perclucro     Decimal    @default(0.00) @db.Decimal(5, 2)
  ativo         Boolean?   @default(true)
  criado_em     DateTime?  @default(now()) @db.Timestamp(0)
  atualizado_em DateTime?  @default(now()) @db.Timestamp(0)
  clientes      clientes[]
}

/// Encomendas de peças aos fornecedores
model encomendas_pecas {
  id                    BigInt                 @id @unique(map: "id") @default(autoincrement()) @db.UnsignedBigInt
  numero_encomenda      String                 @unique(map: "numero_encomenda") @db.VarChar(20)
  fornecedor_id         Int
  data_encomenda        DateTime               @db.Date
  data_entrega_estimada DateTime?              @db.Date
  data_entrega_real     DateTime?              @db.Date
  estado                String?                @default("pendente") @db.VarChar(20)
  custo_total           Decimal?               @db.Decimal(10, 2)
  notas                 String?                @db.Text
  criado_em             DateTime?              @default(now()) @db.Timestamp(0)
  atualizado_em         DateTime?              @default(now()) @db.Timestamp(0)
  criado_por            Int?
  fornecedor            fornecedores           @relation(fields: [fornecedor_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "encomendas_pecas_ibfk_1")
  itens                 itens_encomenda_peca[]

  @@index([estado], map: "estado")
  @@index([fornecedor_id], map: "fornecedor_id")
}

/// Items individuais de uma encomenda de peças
model itens_encomenda_peca {
  id                     BigInt           @id @unique(map: "id") @default(autoincrement()) @db.UnsignedBigInt
  encomenda_id           BigInt           @db.UnsignedBigInt
  peca_id                BigInt           @db.UnsignedBigInt
  quantidade_encomendada Int
  quantidade_recebida    Int?             @default(0)
  preco_unitario         Decimal?         @db.Decimal(10, 2)
  preco_total            Decimal?         @db.Decimal(10, 2)
  estado                 String?          @default("pendente") @db.VarChar(20)
  ordem_trabalho_item_id BigInt?          @db.UnsignedBigInt
  notas                  String?          @db.Text
  criado_em              DateTime?        @default(now()) @db.Timestamp(0)
  encomenda              encomendas_pecas @relation(fields: [encomenda_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "itens_encomenda_peca_ibfk_1")
  peca                   pecas            @relation(fields: [peca_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "itens_encomenda_peca_ibfk_2")

  @@index([encomenda_id], map: "encomenda_id")
  @@index([estado], map: "estado")
  @@index([peca_id], map: "peca_id")
}

/// Alertas do sistema para stock e encomendas
model alertas_sistema {
  id              BigInt    @id @unique(map: "id") @default(autoincrement()) @db.UnsignedBigInt
  tipo            String    @db.VarChar(50)
  titulo          String    @db.VarChar(255)
  descricao       String?   @db.Text
  severidade      String?   @default("normal") @db.VarChar(20)
  referencia_id   BigInt?   @db.UnsignedBigInt
  referencia_tipo String?   @db.VarChar(50)
  lido            Boolean?  @default(false)
  criado_em       DateTime? @default(now()) @db.Timestamp(0)
  lido_em         DateTime? @db.Timestamp(0)

  @@index([criado_em], map: "criado_em")
  @@index([lido], map: "lido")
  @@index([severidade], map: "severidade")
  @@index([tipo], map: "tipo")
}

enum utilizadores_papel {
  admin
  gestor
  mecanico
  rececionista
}
