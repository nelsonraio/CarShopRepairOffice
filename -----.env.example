# Configuração da Base de Dados MySQL
# Formato: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/carrepairshop"

# Ou para Laragon (configuração comum):
# DATABASE_URL="mysql://root:@localhost:3306/carrepairshopgest"

# Configurações opcionais
NEXT_PUBLIC_API_URL="http://localhost:3000"
 
# Chave para alterar estado da aplicação (exemplo)
CHAVE_UTILIZACAO=ADMIN2026$

# Caminho do ficheiro de estado da aplicação (pode ser relativo ao projecto ou absoluto em produção)
# Exemplo para desenvolvimento (relativo):
APP_STATUS_PATH="src/data/app-status.json"
# Exemplo para produção (caminho absoluto recomendado):
# APP_STATUS_PATH="/var/app/data/app-status.json"
